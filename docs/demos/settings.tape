# Shared look for every demo: Terminal Noir colors, floating window frame.
# Each demo tape pulls this in with `Source docs/demos/settings.tape`.

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 18
Set Width 1400
Set Height 820
Set Padding 12
Set Margin 24
Set MarginFill "#2A2A2E"
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 150ms
Set Theme { "name": "Terminal Noir", "background": "#0B0B0C", "foreground": "#F4F4F5", "cursor": "#F5A623", "selection": "#52525B", "black": "#18181B", "red": "#FF7B72", "green": "#34D399", "yellow": "#F5A623", "blue": "#58A6FF", "magenta": "#BC8CFF", "cyan": "#39C5CF", "white": "#A1A1AA", "brightBlack": "#808089", "brightRed": "#FFB7B0", "brightGreen": "#56D364", "brightYellow": "#FACF9E", "brightBlue": "#79C0FF", "brightMagenta": "#D2A8FF", "brightCyan": "#56D4DD", "brightWhite": "#F4F4F5" }
