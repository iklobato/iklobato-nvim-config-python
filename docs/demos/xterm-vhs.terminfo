# xterm-256color with truecolor sent as "38;2;r;g;b". Without setrgbf/setrgbb
# nvim falls back to the colon form "38:2:r:g:b", which the xterm.js in VHS
# reads as colorspace:r:g, so blue is lost and the whole theme turns yellow.
xterm-vhs|xterm-256color with semicolon truecolor for VHS,
	setrgbf=\E[38;2;%p1%d;%p2%d;%p3%dm,
	setrgbb=\E[48;2;%p1%d;%p2%d;%p3%dm,
	use=xterm-256color,
