# Neovim runtime directories
**/.local/share/nvim/
**/.local/state/nvim/
**/.cache/nvim/

# Plugin directories (managed by lazy.nvim)
**/lazy/
**/packer/

# Lock files (keep lazy-lock.json for reproducibility)
# lazy-lock.json is tracked

# Temporary files
*.swp
*.swo
*~
.*.sw?
*.tmp
*.bak
*.orig

# OS files
.DS_Store
Thumbs.db

# Claude settings
**/.claude/settings.local.json

# Logs
*.log

# Homebrew Bundle
# Brewfile is tracked by default for environment reproducibility
# Uncomment the line below if you want to ignore it (user-specific packages)
# Brewfile
Brewfile.backup.*
# scripts/mac_packs.sh writes this next to itself
scripts/installed_packages.txt
**/connections.json
.cursor/
.specify/
.aider*

# Secrets - never commit. Only the *.example templates are tracked.
.secrets.env
secrets.env
*.secret
.env
.env.*
!*.example
.pypirc
.npmrc
**/gh/hosts.yml
.aws/credentials
# SSH private keys
id_rsa
id_ed25519
id_ecdsa
*.pem
*.key

# system/claude is a submodule of the private iklobato/dotclaude repo, so its
# contents (including ~/.claude runtime state) are never tracked here. Its own
# .gitignore governs what dotclaude itself tracks.

# THIS REPO IS PUBLIC. These files name real internal infrastructure of current
# employers (a GitHub Enterprise host) plus work email addresses. Publishing them
# hands a recon target to anyone scraping GitHub, and git history cannot be
# un-published.
system/git/
